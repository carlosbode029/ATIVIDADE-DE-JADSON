# ---------------------------------------------------------------------------
# BK IMPORTS — variáveis de ambiente
# Copie este arquivo para `.env` e preencha com as credenciais reais.
# Nunca commite o arquivo `.env` preenchido.
# ---------------------------------------------------------------------------

# Banco de dados (Supabase Postgres via Prisma)
# DATABASE_URL: conexão pooled (PgBouncer, porta 6543) — usada em runtime.
# DIRECT_URL: conexão direta (porta 5432) — usada apenas pelo Prisma Migrate.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT_REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Cloudinary (mídia de produtos: fotos e vídeos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Mercado Pago (Pix, Cartão, Boleto)
# MERCADO_PAGO_ACCESS_TOKEN: credencial privada (Produção > Credenciais).
# NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY: credencial pública, usada pelo Card
#   Payment Brick no navegador.
# MERCADO_PAGO_WEBHOOK_SECRET: "Assinatura secreta" configurada em
#   Webhooks > Configurar notificações, usada para validar a origem das
#   notificações em src/app/api/webhooks/mercado-pago/route.ts.
#   URL do webhook a cadastrar no painel: https://SEU_DOMINIO/api/webhooks/mercado-pago
#   Eventos a assinar: "Pagamentos".
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_WEBHOOK_SECRET=""
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=""

# WhatsApp (botão flutuante e pedido automático)
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
